{
  "kind": "collectionType",
  "collectionName": "teachers",
  "info": {
    "singularName": "teacher",
    "pluralName": "teachers",
    "displayName": "teacher"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "minLength": 4,
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": false
    },
    "teacherEmail": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "events": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::event.event",
      "mappedBy": "teachers"
    },
    "classes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::class.class",
      "mappedBy": "teachers"
    }
  }
}
